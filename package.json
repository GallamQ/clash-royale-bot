{
  "name": "clan-bot-ts",
  "version": "2.0.1",
  "description": "Discord bot for a Clash Royale clan: war tracking, podium, sanctions and joker system, written in TypeScript.",
  "private": true,
  "license": "MIT",
  "author": "Quentin \"Gallam\" Detré",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/GallamQ/clash-royale-bot.git"
  },
  "bugs": {
    "url": "https://github.com/GallamQ/clash-royale-bot/issues"
  },
  "homepage": "https://github.com/GallamQ/clash-royale-bot#readme",
  "keywords": [
    "discord",
    "discord-bot",
    "clash-royale",
    "typescript",
    "postgresql"
  ],
  "type": "commonjs",
  "scripts": {
    "test": "tsx --test \"tests/**/*.test.ts\"",
    "typecheck": "tsc --noEmit",
    "format": "prettier --check src tests",
    "release": "commit-and-tag-version",
    "register-commands": "node --env-file=.env --import tsx src/admin/registerCommands.ts"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.2",
    "@types/pg": "^8.23.1",
    "commit-and-tag-version": "^13.3.0",
    "prettier": "3.9.9",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "discord-interactions": "^4.4.0",
    "express": "^5.2.1",
    "pg": "^8.23.0",
    "tsx": "^4.23.15"
  }
}
